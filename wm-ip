#!/usr/bin/env bash

cd "$(dirname "$(readlink -f "$0")")" || return 9
# shellcheck source=lib/echo.sh
source lib/echo.sh || exit 2

mwan3_is_active() {
  /etc/init.d/mwan3 running 2>/dev/null
}

mwan3_is_patched() {
  grep -q "PATCHED BY PSCHMITT" /usr/sbin/mwan3
}

# shellcheck disable=SC2317,SC2329
get_wan_interfaces() {
  local uci_path
  uci_path="$(uci show firewall | awk "/name=[\"']wan[\"']/" | sed -r "s#.name=[\"']wan['\"]##")"

  if [[ -z "$uci_path" ]]
  then
    echo "Failed to find wan firewall config path" >&2
    return 1
  fi

  # Remove any ipv6 interfaces
  local intf
  for intf in $(uci get "${uci_path}.network" | sed -r 's#[^ ]+6##g')
  do
    get_interface "$intf"
  done
}

get_interface() {
  local uci_name="$1"
  local value
  value="$(uci get "network.${uci_name}.device" 2>/dev/null)"

  if grep -qE '^/' <<< "$value"
  then
    # NOTE modemmanager devices are addressed via real fs paths:
    # /sys/devices/platform/soc/soc:internal-regs/f1058000.usb/usb1/1-1
    mmcli -m any 2>/dev/null | sed -nr 's#.*, ([^ ]+) \(net\)#\1#p'
  # default to returning the uci interface name
  # this is necessary for WG interfaces, such as mullvad
  elif [[ -z $value ]]
  then
    echo "$uci_name"
  else
    echo "$value"
  fi
}

# mapfile -t WAN_INTERFACES < <(get_wan_interfaces)
# echo "WAN_INTERFACES: ${WAN_INTERFACES[*]}" >&2

WAN="wan"
LTE="wwan"
LTE_INT="quectel"
VPN="mullvad"
# shellcheck disable=SC2206
UCI_INTERFACES=($WAN $LTE $VPN)

# Resolve via DoH *through the interface under test*, so that a dead default
# route (eg. the primary WAN) does not break checks of the other interfaces.
resolve() {
  local host="$1"
  local intf="$2"
  local type="A"
  local rrtype=1
  local -a servers=(
    "https://1.1.1.1/dns-query"
    "https://8.8.8.8/resolve"
  )

  if [[ -n "$IPV6" ]]
  then
    type="AAAA"
    rrtype=28
    servers=(
      "https://[2606:4700:4700::1111]/dns-query"
      "https://[2001:4860:4860::8888]/resolve"
    )
  fi

  local server ip_addr
  for server in "${servers[@]}"
  do
    if ip_addr="$(curl -fsSL --max-time "$DOH_TIMEOUT" --interface "$intf" \
      -H "accept: application/dns-json" \
      "${server}?name=${host}&type=${type}" 2>/dev/null | \
      jq -er --argjson t "$rrtype" \
        'first(.Answer[]? | select(.type == $t) | .data)')"
    then
      echo "$ip_addr"
      return 0
    fi
  done

  return 1
}

provider_host() {
  local provider="$1"

  # ipinfo.io is reachable via ipv6, but on a differnent host
  # https://ipinfo.io/faq/article/133-do-you-support-ipv6
  if [[ "$provider" == "ipinfo.io" && -n "$IPV6" ]]
  then
    echo "v6.ipinfo.io"
    return 0
  fi

  echo "$provider"
}

provider_path() {
  case "$1" in
    myip.wtf|ipinfo.io)
      echo "/json"
      ;;
    *)
      echo "/"
      ;;
  esac
}

# Query a provider over HTTPS, pinning the resolved address with --resolve.
# Unlike the former plain HTTP + Host header approach, a stale or hijacked IP
# fails the TLS handshake instead of returning some unrelated 404 page.
query_provider() {
  local provider="$1"
  local uci_intf="$2"
  local intf="$3"
  local host ip_addr

  host="$(provider_host "$provider")"

  if ! ip_addr="$(resolve "$host" "$intf")"
  then
    echo "Failed to resolve $host via interface $intf" >&2
    return 1
  fi

  if [[ -n "$IPV6" ]]
  then
    ip_addr="[${ip_addr}]"
  fi

  # shellcheck disable=SC2086
  ${MWAN3_ACTIVE:+mwan3 use "$uci_intf"} curl -fsSL \
    --max-time "$CURL_TIMEOUT" \
    --interface "$intf" \
    "${CURL_ARGS[@]}" \
    --resolve "${host}:443:${ip_addr}" \
    "https://${host}$(provider_path "$provider")"
}

format_data() {
  local provider="$1"
  local data="$2"

  case "$provider" in
    ipinfo.io)
      jq -er --arg provider "$provider" '
        "isp: " + .org + "\n" +
        "ip: " + .ip + "\n" +
        "ip-provider: " + $provider
      ' <<< "$data"
      ;;
    ip.guide)
      jq -er --arg provider "$provider" '
        "isp: " + .network.autonomous_system.organization + "\n" +
        "hostname: " + .network.autonomous_system.name + "\n" +
        "ip: " + .ip + "\n" +
        "ip-provider: " + $provider
      ' <<< "$data"
      ;;
    myip.wtf)
      jq -er --arg provider "$provider" '
        "isp: " + .YourFuckingISP + "\n" +
        "ip: " + .YourFuckingIPAddress + "\n" +
        "location: " + .YourFuckingLocation + "\n" +
        "ip-provider: " + $provider
      ' <<< "$data"
      ;;
    *)
      echo "Unknown provider: $provider" >&2
      return 1
      ;;
  esac
}

# Providers are tried in order, the first one that answers wins.
# NOTE as of 2024-10-25 ip.guide yields a 404 error..!
# shellcheck disable=SC2206
PROVIDERS=(${PROVIDER:-myip.wtf ipinfo.io})
NO_COLOR="${NO_COLOR:-}"
CURL_ARGS=()

# Disable colors by default if run via monit
if [[ -n "$MONIT_SERVICE" ]]
then
  NO_COLOR=1
fi

CURL_TIMEOUT=10
DOH_TIMEOUT=5

while [[ -n "$*" ]]
do
  case "$1" in
    -4|--ipv4)
      # Nothing to do here, IPv4 is the default
      shift
      ;;
    -6|--ipv6)
      IPV6=1
      shift
      ;;
    --provider|-p)
      PROVIDERS=("$2")
      shift 2
      ;;
    --no-color|-nocolor)
      NO_COLOR=1
      shift
      ;;
    -t|--timeout)
      CURL_TIMEOUT="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

# Only process a particular interface if requested by the user
case "$1" in
  lte|wwan*)
    UCI_INTERFACES=("$LTE")
    ;;
  mm|quectel|qectel)
    UCI_INTERFACES=("$LTE_INT")
    ;;
  wan|cable|vodafone)
    UCI_INTERFACES=("$WAN")
    ;;
esac

if [[ -n "$IPV6" ]]
then
  CURL_ARGS=("-6")
else
  CURL_ARGS=("-4")
fi

RC=0

if mwan3_is_active
then
  if ! mwan3_is_patched
  then
    echo_warning "mwan3 is active. RC might be always 0"
  fi
  MWAN3_ACTIVE=1
fi

for uci_intf in "${UCI_INTERFACES[@]}"
do
  [[ -n $IPV6 ]] && uci_intf+="6"
  i=$(get_interface "$uci_intf")

  echo_info "Interface: $uci_intf ($i)"

  DATA=""
  for provider in "${PROVIDERS[@]}"
  do
    if DATA="$(query_provider "$provider" "$uci_intf" "$i")" && [[ -n "$DATA" ]]
    then
      break
    fi
    echo "Failed to reach $provider on interface $i" >&2
    DATA=""
  done

  if [[ -z "$DATA" ]]
  then
    RC=1
    continue
  fi

  if ! format_data "$provider" "$DATA"
  then
    RC=1
  fi
done

exit "$RC"
