#!/usr/bin/env bash

cd "$(dirname "$(readlink -f -- "$0")")" || exit 9
# shellcheck source=lib/echo.sh
source lib/echo.sh || exit 2

# Display the script usage.
usage() {
  echo "Usage: $(basename "$0") [--dry-run|--dryrun|-k]"
}

# Parse command line arguments.
parse_args() {
  local arg

  for arg in "$@"
  do
    case "$arg" in
      --dry-run|--dryrun|-k)
        DRY_RUN=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo_error "Unknown argument: $arg"
        usage >&2
        exit 2
        ;;
    esac
  done
}

# Normalize an OS hostname for a DNS label.
normalize_hostname() {
  local name="$1"
  name=${name//[ _]/-}
  echo "${name,,}"
}

# Read the current DNS label from a Tailscale device record.
normalize_dns_label() {
  local name="$1"
  name=${name%%.*}
  echo "${name,,}"
}

# Read a remote host's OS hostname using either configured SSH name.
read_remote_hostname() {
  local tailscale_name="$1"
  local dns_name="$2"
  local target

  for target in "$tailscale_name" "$dns_name"
  do
    if ssh -q -o BatchMode=yes -o ConnectTimeout=5 -- "$target" 'hostname -s 2>/dev/null || uname -n' 2>/dev/null
    then
      return 0
    fi
  done

  return 1
}

# Rename one remote Tailscale device, forcing the control plane to release a stale name.
rename_remote_device() {
  local target="$1"
  local temporary_name="$2"
  local desired_name="$3"

  ssh -q -o BatchMode=yes -o ConnectTimeout=5 -- "$target" sh -s -- "$temporary_name" "$desired_name" <<'REMOTE'
set -eu
sudo -n tailscale set --hostname="$1"
sleep 2
sudo -n tailscale set --hostname="$2"
i=0
while [ "$i" -lt 20 ]
do
  current_dns=$(tailscale status --json | jq -er '.Self.DNSName | split(".")[0]')
  if [ "$current_dns" = "$2" ]
  then
    printf '%s\n' "$current_dns"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done
printf '%s\n' "$current_dns"
exit 1
REMOTE
}

# Rename this device and verify its MagicDNS name.
rename_local_device() {
  local temporary_name="$1"
  local desired_name="$2"
  local current_dns
  local i=0

  tailscale set --hostname="$temporary_name"
  sleep 2
  tailscale set --hostname="$desired_name"
  while [[ $i -lt 20 ]]
  do
    current_dns=$(tailscale status --json | jq -er '.Self.DNSName | split(".")[0]')
    if [[ $current_dns == "$desired_name" ]]
    then
      echo "$current_dns"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done

  echo "$current_dns"
  return 1
}

# Discover all tailnet devices and correct online hostname mismatches.
process_devices() {
  local status_json peer node_data is_self hostname dns_name online current_dns
  local desired_name advertised_name temporary_name updated_dns ssh_target
  local exit_code=0
  local -a peer_entries_json

  if ! status_json="$(tailscale status --json)"
  then
    echo_error "Failed to fetch Tailscale device data"
    return 1
  fi

  if ! mapfile -t peer_entries_json < <(jq -cer '({node: .Self, is_self: true}), (.Peer[] | {node: ., is_self: false})' <<< "$status_json")
  then
    echo_error "Failed to parse Tailscale device data"
    return 1
  fi

  for peer in "${peer_entries_json[@]}"
  do
    node_data=$(jq -c '.node' <<< "$peer")
    is_self=$(jq -r '.is_self' <<< "$peer")
    hostname=$(jq -er '.HostName' <<< "$node_data")
    dns_name=$(jq -er '.DNSName' <<< "$node_data")
    dns_name=${dns_name%.}
    online=$(jq -r 'if has("Online") then .Online else true end' <<< "$node_data")
    current_dns=$(normalize_dns_label "$dns_name")
    advertised_name=$(normalize_hostname "$hostname")

    if [[ $is_self != true && $online != true ]]
    then
      echo_info "Skipping offline device: $hostname ($dns_name)"
      continue
    fi

    if [[ $is_self != true && $current_dns == "$advertised_name" ]]
    then
      echo_success "$hostname already uses its OS hostname in MagicDNS: $current_dns"
      continue
    fi

    if [[ $is_self == true ]]
    then
      desired_name=$(normalize_hostname "$(uname -n 2>/dev/null || cat /proc/sys/kernel/hostname)")
      ssh_target=
    else
      desired_name=$(read_remote_hostname "$hostname" "$dns_name") || {
        echo_error "Could not read the OS hostname over SSH: $hostname ($dns_name)"
        exit_code=1
        continue
      }
      desired_name=$(normalize_hostname "$desired_name")
      ssh_target=$hostname
      if ! ssh -q -o BatchMode=yes -o ConnectTimeout=5 -- "$ssh_target" true 2>/dev/null
      then
        ssh_target=$dns_name
      fi
    fi

    if [[ ! $desired_name =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]
    then
      echo_error "Invalid DNS hostname reported by $hostname: $desired_name"
      exit_code=1
      continue
    fi

    if [[ $current_dns == "$desired_name" ]]
    then
      echo_success "$hostname already uses its OS hostname in MagicDNS: $current_dns"
      continue
    fi

    temporary_name="${desired_name}-fix-$(date +%s)"
    echo_info "$hostname: $current_dns -> $temporary_name -> $desired_name"

    if [[ -n $DRY_RUN ]]
    then
      continue
    fi

    if [[ $is_self == true ]]
    then
      if ! updated_dns=$(rename_local_device "$temporary_name" "$desired_name")
      then
        echo_error "Could not reset the local Tailscale machine name"
        exit_code=1
        continue
      fi
    elif ! updated_dns=$(rename_remote_device "$ssh_target" "$temporary_name" "$desired_name")
    then
      echo_error "Could not reset the Tailscale machine name on $hostname ($dns_name)"
      exit_code=1
      continue
    fi

    echo_success "$hostname now uses its OS hostname in MagicDNS: $updated_dns"
  done

  return "$exit_code"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  DRY_RUN=

  parse_args "$@"

  if ! process_devices
  then
    exit 1
  fi
fi
