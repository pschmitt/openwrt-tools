#!/usr/bin/env bash

cd "$(dirname "$(readlink -f -- "$0")")" || return 9
# shellcheck source=lib/echo.sh
source lib/echo.sh || exit 2

# Display the script usage.
usage() {
  echo "Usage: $(basename "$0") [--dry-run|--dryrun|-k]"
}

# Parse command line arguments.
parse_args() {
  local arg

  for arg in "$@"
  do
    case "$arg" in
      --dry-run|--dryrun|-k)
        DRY_RUN=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo_error "Unknown argument: $arg"
        usage >&2
        exit 2
        ;;
    esac
  done
}

# Normalise the peer name by replacing underscores and converting to lowercase.
normalize_peer_name() {
  local name="$1"
  name=${name//_/-}
  echo "${name,,}"
}

# Strip a trailing Unix-timestamp suffix added by a previous temp-rename
# (e.g. rofl-12-1780310160 -> rofl-12).
strip_timestamp_suffix() {
  local name="$1"
  echo "${name%-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]}"
}

# Extract the DNS label prefix from the peer data and lowercase it.
normalize_dns_label() {
  local label="$1"

  if [[ -z "$label" ]]
  then
    echo ""
    return 0
  fi

  label=${label%%.*}
  echo "${label,,}"
}

# Update a peer name, honouring dry run mode.
update_peer_name() {
  local peer_id="$1"
  local new_name="$2"
  local cli_bin
  cli_bin="${NB_CLI_BIN:-netbird-cli}"

  if [[ -n "$DRY_RUN" ]]
  then
    echo_info "Dry run: $cli_bin peer update --name \"$new_name\" \"$peer_id\""
    return 0
  fi

  # netbird-cli peer update exits non-zero even on success (broken jq/column
  # in the display path), so we run it unconditionally and trust it worked.
  "$cli_bin" peer update --name "$new_name" "$peer_id" || true
}

# Names and NetBird IPs of rworker-provided machines (image rworker-*), one
# per line. Empty when rworker is unavailable.
fetch_worker_ids() {
  command -v rworker &>/dev/null || return 0
  rworker ls -o json 2>/dev/null | jq -r '
    .[] | select((.image_name // "") | startswith("rworker-"))
    | .name, (.ips.netbird // empty), (.ip // empty)' 2>/dev/null || true
}

# Succeed if the peer is an rworker machine.
is_worker_peer() {
  local peer="$1" peer_name="$2" peer_ip

  peer_ip="$(jq -r '.ip // ""' <<< "$peer")"
  if [[ -n $WORKER_IDS ]] && grep -qxF -e "$peer_name" -e "${peer_ip:-@none@}" <<< "$WORKER_IDS"
  then
    return 0
  fi

  jq -e '[(.groups // [])[] | (if type == "object" then (.name // "") else . end)]
         | any(test("-workers$"))' <<< "$peer" &>/dev/null
}

# Fetch peers from netbird-cli and fix mismatched hostnames.
process_peers() {
  local cli_bin peers_json peer_entries_json peer peer_id peer_name peer_dns_label
  local normalized_peer_name normalized_dns_name timestamp

  cli_bin="${NB_CLI_BIN:-netbird-cli}"
  WORKER_IDS="$(fetch_worker_ids)"

  if ! peers_json="$("$cli_bin" peers --json)"
  then
    echo_error "Failed to fetch netbird peer data"
    return 1
  fi

  if ! mapfile -t peer_entries_json < <(jq -cer '.[]' <<< "$peers_json")
  then
    echo_error "Failed to parse peer JSON"
    return 1
  fi

  for peer in "${peer_entries_json[@]}"
  do
    echo_debug -d "Peer data: $peer"

    if ! read -r peer_id peer_name peer_dns_label <<< "$(jq -er '[.id, (.name // ""), (.dns_label // "")] | @tsv' <<< "$peer")"
    then
      echo_warning "Skipping peer due to missing fields: $peer"
      continue
    fi

    if [[ $peer_name == github-runner* ]]
    then
      echo_info "Skipping GitHub runner peer: $peer_name"
      continue
    fi

    # Ephemeral workers (rworker ad-hoc, nixbot and circus pools) have varying
    # name prefixes: skip peers that rworker lists (rworker-provided image),
    # or that sit in a NetBird "*-workers" group.
    if is_worker_peer "$peer" "$peer_name"
    then
      echo_info "Skipping rworker peer: $peer_name"
      continue
    fi

    normalized_peer_name="$(normalize_peer_name "$peer_name")"
    canonical_peer_name="$(strip_timestamp_suffix "$normalized_peer_name")"
    normalized_dns_name="$(normalize_dns_label "$peer_dns_label")"

    if [[ -z "$canonical_peer_name" ]]
    then
      echo_warning "Skipping peer with empty name: $peer"
      continue
    fi

    echo_info "Processing peer: $canonical_peer_name - DNS hostname: ${normalized_dns_name:-none} (${peer_dns_label:-none})"

    if [[ "$canonical_peer_name" == "$normalized_dns_name" ]]
    then
      echo_success "Peer $canonical_peer_name has valid DNS label: ${peer_dns_label:-none}"
      continue
    fi

    echo_warning "Peer $canonical_peer_name has mismatched DNS label: ${peer_dns_label:-none}"

    timestamp="$(date '+%s')"
    if ! update_peer_name "$peer_id" "${canonical_peer_name}_${timestamp}"
    then
      echo_error "Failed to set temporary name for peer $peer_id"
      continue
    fi

    if ! update_peer_name "$peer_id" "$canonical_peer_name"
    then
      echo_error "Failed to restore name for peer $peer_id"
      continue
    fi

    echo_success "Updated peer $peer_id name to $canonical_peer_name"
  done

  return 0
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  DRY_RUN=

  parse_args "$@"

  if ! process_peers
  then
    exit 1
  fi
fi
